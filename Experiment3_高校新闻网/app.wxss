page {
  background-color: #f5f7fa;
  color: #333333;
  font-family: Arial, "Microsoft YaHei", sans-serif;
}


/* 新闻列表 */
.news-list {
  padding: 20rpx;
  box-sizing: border-box;
}


/* 新闻卡片 */
.news-item {
  display: flex;
  flex-direction: row;

  background-color: #ffffff;

  margin-bottom: 20rpx;
  padding: 16rpx;

  border-radius: 16rpx;

  box-sizing: border-box;

  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}


/* 新闻图片 */
.news-item image {
  width: 220rpx;
  height: 145rpx;

  flex-shrink: 0;

  border-radius: 12rpx;

  margin-right: 20rpx;
}


/* 新闻信息 */
.news-info {
  flex: 1;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 5rpx 0;
}


/* 新闻标题 */
.news-title {
  font-size: 28rpx;
  line-height: 42rpx;
  color: #333333;
}


/* 新闻日期 */
.news-date {
  font-size: 23rpx;
  color: #999999;
}