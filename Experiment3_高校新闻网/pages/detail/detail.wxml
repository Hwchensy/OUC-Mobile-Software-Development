<!-- pages/detail/detail.wxml -->

<view class="container">

<!-- 新闻标题 -->
<view class="title">
  {{article.title}}
</view>


<!-- 日期 -->
<view class="date">
  {{article.add_date}}
</view>


<!-- 新闻图片 -->
<view class="poster">

  <image
    src="{{article.poster}}"
    mode="widthFix"
  ></image>

</view>


<!-- 正文 -->
<view class="content">

  <text>
    {{article.content}}
  </text>

</view>


<!-- 操作按钮 -->

<view class="action-area">

  <!-- 收藏 -->

  <button
    wx:if="{{isAdd}}"
    class="action-btn favorite-active"
    bindtap="cancelFavorites"
  >
    ❤️ 已收藏
  </button>


  <button
    wx:else
    class="action-btn"
    bindtap="addFavorites"
  >
    ♡ 收藏新闻
  </button>


  <!-- 分享 -->

  <button
    class="action-btn share-btn"
    open-type="share"
  >
    ↗ 分享新闻
  </button>

</view>

</view>