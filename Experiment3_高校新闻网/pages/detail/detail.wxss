/* pages/detail/detail.wxss */

page {
  background-color: #f5f7fa;
}


.container {
  padding: 35rpx 30rpx 60rpx;

  background-color: #ffffff;

  min-height: 100vh;

  box-sizing: border-box;
}


/* =========================
   新闻标题
   ========================= */

.title {

  font-size: 40rpx;

  font-weight: bold;

  color: #222222;

  line-height: 58rpx;

  text-align: center;

  margin-bottom: 18rpx;

}


/* =========================
   日期
   ========================= */

.date {

  text-align: center;

  color: #999999;

  font-size: 24rpx;

  margin-bottom: 30rpx;

}


/* =========================
   新闻图片
   ========================= */

.poster {

  width: 100%;

  border-radius: 16rpx;

  overflow: hidden;

  margin-bottom: 35rpx;

}

.poster image {

  width: 100%;

  display: block;

}


/* =========================
   正文
   ========================= */

.content {

  padding: 0 10rpx;

}

.content text {

  font-size: 30rpx;

  color: #444444;

  line-height: 55rpx;

  text-align: left;

}


/* =========================
   操作按钮
   ========================= */

.action-area {

  margin-top: 50rpx;

  display: flex;

  justify-content: center;

  gap: 20rpx;

}


/* 两个按钮 */

.action-btn {

  width: 280rpx;

  height: 78rpx;

  line-height: 78rpx;

  margin: 0;

  padding: 0;

  border-radius: 40rpx;

  border: 2rpx solid #328EEB;

  color: #328EEB;

  background-color: white;

  font-size: 27rpx;

  box-sizing: border-box;

}


/* 已收藏 */

.favorite-active {

  background-color: #328EEB;

  color: white;

}


/* 分享按钮 */

.share-btn {

  background-color: #f5f9ff;

}


.action-btn::after {

  border: none;

}