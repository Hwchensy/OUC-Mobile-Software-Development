/* ==================================================
   页面
   ================================================== */

   page {
    background-color: #f5f7fa;
  }
  
  
  
  /* ==================================================
     用户卡片
     ================================================== */
  
  .user-card {
    width: 100%;
    height: 280rpx;
    padding: 40rpx 35rpx;
    box-sizing: border-box;
  
    background: linear-gradient(
      135deg,
      #328EEB,
      #5aa9f5
    );
  
    display: flex;
    align-items: center;
  }
  
  
  /* 头像 */
  
  .avatar,
  .default-avatar {
    width: 145rpx;
    height: 145rpx;
    border-radius: 50%;
    flex-shrink: 0;
  }
  
  
  .avatar {
    border: 5rpx solid rgba(255,255,255,0.9);
  }
  
  
  .default-avatar {
    background-color: rgba(255,255,255,0.9);
  
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  
  .default-avatar text {
    font-size: 70rpx;
  }
  
  
  /* 用户信息 */
  
  .user-info {
    flex: 1;
    margin-left: 28rpx;
  
    display: flex;
    flex-direction: column;
  }
  
  
  .nickname {
    color: white;
    font-size: 38rpx;
    font-weight: bold;
    line-height: 55rpx;
  }
  
  
  .welcome {
    margin-top: 8rpx;
  
    color: rgba(255,255,255,0.85);
  
    font-size: 23rpx;
  
    line-height: 35rpx;
  }
  
  
  /* 登录按钮 */
  
  .login-btn {
    width: 165rpx;
    height: 68rpx;
  
    padding: 0;
    margin: 0;
  
    line-height: 68rpx;
  
    border-radius: 35rpx;
  
    background-color: white;
  
    color: #328EEB;
  
    font-size: 25rpx;
  }
  
  
  .login-btn::after {
    border: none;
  }
  
  
  
  /* ==================================================
     收藏区域
     ================================================== */
  
  .favorite-section {
    margin: 25rpx;
  
    background-color: white;
  
    border-radius: 20rpx;
  
    padding: 30rpx;
  
    box-sizing: border-box;
  
    box-shadow: 0 5rpx 20rpx rgba(0,0,0,0.04);
  }
  
  
  /* 标题 */
  
  .section-header {
    display: flex;
  
    align-items: center;
  
    justify-content: space-between;
  
    padding-bottom: 25rpx;
  
    border-bottom: 1rpx solid #eeeeee;
  }
  
  
  .section-title {
    display: block;
  
    font-size: 35rpx;
  
    font-weight: bold;
  
    color: #222222;
  }
  
  
  .section-subtitle {
    display: block;
  
    margin-top: 4rpx;
  
    font-size: 19rpx;
  
    color: #aaaaaa;
  
    letter-spacing: 2rpx;
  }
  
  
  /* 收藏数量 */
  
  .favorite-count {
    width: 62rpx;
    height: 62rpx;
  
    border-radius: 50%;
  
    background-color: #328EEB;
  
    color: white;
  
    font-size: 25rpx;
  
    display: flex;
  
    align-items: center;
  
    justify-content: center;
  }
  
  
  /* 空状态 */
  
  .empty-box {
    height: 300rpx;
  
    display: flex;
  
    flex-direction: column;
  
    align-items: center;
  
    justify-content: center;
  }
  
  
  .empty-icon {
    font-size: 60rpx;
  
    margin-bottom: 15rpx;
  }
  
  
  .empty-title {
    font-size: 29rpx;
  
    font-weight: bold;
  
    color: #555555;
  }
  
  
  .empty-desc {
    margin-top: 8rpx;
  
    font-size: 23rpx;
  
    color: #aaaaaa;
  }
  
  
  
  /* ==================================================
     收藏列表
     ================================================== */
  
  .news-item {
    min-height: 160rpx;
  
    padding: 18rpx 0;
  
    box-sizing: border-box;
  
    display: flex;
  
    border-bottom: 1rpx solid #eeeeee;
  }
  
  
  .news-item:last-child {
    border-bottom: none;
  }
  
  
  .news-item > image {
    width: 205rpx;
  
    height: 135rpx;
  
    border-radius: 12rpx;
  
    flex-shrink: 0;
  
    background-color: #eeeeee;
  }
  
  
  .news-info {
    flex: 1;
  
    margin-left: 20rpx;
  
    display: flex;
  
    flex-direction: column;
  
    justify-content: space-between;
  
    min-width: 0;
  }
  
  
  .news-title {
    font-size: 27rpx;
  
    color: #333333;
  
    line-height: 42rpx;
  
    display: -webkit-box;
  
    -webkit-box-orient: vertical;
  
    -webkit-line-clamp: 2;
  
    overflow: hidden;
  }
  
  
  .news-date {
    font-size: 22rpx;
  
    color: #999999;
  }
  
  
  
  /* ==================================================
     功能菜单
     ================================================== */
  
  .menu-section {
    margin: 25rpx;
  
    background-color: white;
  
    border-radius: 20rpx;
  
    overflow: hidden;
  
    box-shadow: 0 5rpx 20rpx rgba(0,0,0,0.04);
  }
  
  
  .menu-item {
    height: 115rpx;
  
    padding: 0 30rpx;
  
    box-sizing: border-box;
  
    display: flex;
  
    align-items: center;
  
    justify-content: space-between;
  }
  
  
  .menu-item + .menu-item {
    border-top: 1rpx solid #eeeeee;
  }
  
  
  .menu-left {
    display: flex;
  
    align-items: center;
  }
  
  
  .menu-icon {
    width: 70rpx;
    height: 70rpx;
  
    border-radius: 18rpx;
  
    display: flex;
  
    align-items: center;
  
    justify-content: center;
  
    font-size: 35rpx;
  
    background-color: #f0f6ff;
  }
  
  
  .menu-text {
    margin-left: 22rpx;
  
    display: flex;
  
    flex-direction: column;
  }
  
  
  .menu-title {
    font-size: 29rpx;
  
    color: #333333;
  
    font-weight: 500;
  }
  
  
  .menu-desc {
    margin-top: 6rpx;
  
    font-size: 21rpx;
  
    color: #999999;
  }
  
  
  .menu-arrow {
    font-size: 45rpx;
  
    color: #bbbbbb;
  
    line-height: 45rpx;
  }
  
  
  
  /* ==================================================
     弹窗背景
     ================================================== */
  
  .popup-mask {
    position: fixed;
  
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
  
    background-color: rgba(0,0,0,0.55);
  
    display: flex;
  
    align-items: center;
  
    justify-content: center;
  
    z-index: 9999;
  }
  
  
  
  /* ==================================================
     弹窗
     ================================================== */
  
  .popup-panel {
    width: 650rpx;
  
    background-color: white;
  
    border-radius: 25rpx;
  
    padding: 35rpx;
  
    box-sizing: border-box;
  }
  
  
  .popup-header {
    height: 55rpx;
  
    display: flex;
  
    align-items: center;
  
    justify-content: space-between;
  }
  
  
  .popup-title {
    font-size: 36rpx;
  
    font-weight: bold;
  
    color: #222222;
  }
  
  
  .popup-close {
    width: 55rpx;
    height: 55rpx;
  
    display: flex;
  
    align-items: center;
  
    justify-content: center;
  
    font-size: 42rpx;
  
    color: #999999;
  }
  
  
  .popup-line {
    width: 100%;
  
    height: 1rpx;
  
    background-color: #eeeeee;
  
    margin: 20rpx 0;
  }
  
  
  
  /* ==================================================
     设置选项
     ================================================== */
  
  .option-item {
    min-height: 100rpx;
  
    display: flex;
  
    align-items: center;
  
    justify-content: space-between;
  }
  
  
  .option-left {
    display: flex;
  
    flex-direction: column;
  }
  
  
  .option-title {
    font-size: 28rpx;
  
    color: #333333;
  }
  
  
  .option-desc {
    margin-top: 7rpx;
  
    font-size: 22rpx;
  
    color: #999999;
  }
  
  
  .option-arrow {
    font-size: 42rpx;
  
    color: #bbbbbb;
  }
  
  
  .option-line {
    height: 1rpx;
  
    background-color: #eeeeee;
  }
  
  
  .version {
    font-size: 23rpx;
  
    color: #999999;
  }
  
  
  
  /* ==================================================
     弹窗底部按钮
     ================================================== */
  
  .popup-button {
    width: 100%;
  
    height: 78rpx;
  
    margin: 30rpx 0 0;
  
    padding: 0;
  
    line-height: 78rpx;
  
    border-radius: 40rpx;
  
    background-color: #328EEB;
  
    color: white;
  
    font-size: 28rpx;
  }
  
  
  .popup-button::after {
    border: none;
  }
  
  
  
  /* ==================================================
     账号管理
     ================================================== */
  
  .account-panel {
    min-height: 450rpx;
  }
  
  
  .account-info {
    padding: 25rpx 0;
  
    display: flex;
  
    align-items: center;
  }
  
  
  .account-avatar {
    width: 105rpx;
    height: 105rpx;
  
    border-radius: 50%;
  }
  
  
  .account-name {
    margin-left: 25rpx;
  
    display: flex;
  
    flex-direction: column;
  }
  
  
  .account-nickname {
    font-size: 32rpx;
  
    font-weight: bold;
  
    color: #333333;
  }
  
  
  .account-status {
    margin-top: 7rpx;
  
    font-size: 22rpx;
  
    color: #328EEB;
  }
  
  
  .account-option {
    height: 90rpx;
  
    border-top: 1rpx solid #eeeeee;
  
    border-bottom: 1rpx solid #eeeeee;
  
    display: flex;
  
    align-items: center;
  
    justify-content: space-between;
  }
  
  
  .account-option-title {
    font-size: 28rpx;
  
    color: #333333;
  }
  
  
  /* 退出登录 */
  
  .logout-button {
    width: 100%;
  
    height: 75rpx;
  
    margin: 25rpx 0 0;
  
    padding: 0;
  
    line-height: 75rpx;
  
    border-radius: 38rpx;
  
    background-color: #fff1f1;
  
    color: #e64340;
  
    font-size: 27rpx;
  }
  
  
  .logout-button::after {
    border: none;
  }
  
  
  
  /* ==================================================
     未登录账号
     ================================================== */
  
  .account-empty {
    padding: 50rpx 0;
  
    display: flex;
  
    flex-direction: column;
  
    align-items: center;
  }
  
  
  .account-empty-icon {
    font-size: 60rpx;
  
    margin-bottom: 15rpx;
  }
  
  
  .account-empty-title {
    font-size: 30rpx;
  
    font-weight: bold;
  
    color: #555555;
  }
  
  
  .account-empty-desc {
    margin-top: 8rpx;
  
    font-size: 23rpx;
  
    color: #999999;
  }
  
  
  .account-login-button {
    width: 250rpx;
  
    height: 70rpx;
  
    margin-top: 25rpx;
  
    padding: 0;
  
    line-height: 70rpx;
  
    border-radius: 35rpx;
  
    background-color: #328EEB;
  
    color: white;
  
    font-size: 26rpx;
  }
  
  
  .account-login-button::after {
    border: none;
  }
  
  
  
  /* ==================================================
     登录 / 修改信息
     ================================================== */
  
  .login-panel {
    padding-bottom: 40rpx;
  }
  
  
  .login-desc {
    display: block;
  
    margin: 15rpx 0 30rpx;
  
    text-align: center;
  
    font-size: 23rpx;
  
    color: #999999;
  }
  
  
  .choose-avatar {
    width: 155rpx;
  
    height: 155rpx;
  
    padding: 0;
  
    margin: 0 auto;
  
    border-radius: 50%;
  
    background-color: #f2f5f8;
  
    display: flex;
  
    align-items: center;
  
    justify-content: center;
  
    color: #328EEB;
  
    font-size: 24rpx;
  
    overflow: hidden;
  }
  
  
  .choose-avatar::after {
    border: none;
  }
  
  
  .choose-avatar-img {
    width: 155rpx;
  
    height: 155rpx;
  }
  
  
  .nickname-input {
    width: 100%;
  
    height: 80rpx;
  
    margin-top: 30rpx;
  
    padding: 0 25rpx;
  
    box-sizing: border-box;
  
    border: 1rpx solid #dddddd;
  
    border-radius: 12rpx;
  
    font-size: 27rpx;
  }
  
  
  
  /* ==================================================
     登录按钮
     ================================================== */
  
  .login-actions {
    width: 100%;
  
    margin-top: 30rpx;
  
    display: flex;
  
    justify-content: space-between;
  }
  
  
  .cancel-btn,
  .confirm-btn {
    width: 275rpx;
  
    height: 75rpx;
  
    padding: 0;
  
    margin: 0;
  
    line-height: 75rpx;
  
    border-radius: 40rpx;
  
    font-size: 27rpx;
  }
  
  
  .cancel-btn {
    background-color: #f3f3f3;
  
    color: #666666;
  }
  
  
  .confirm-btn {
    background-color: #328EEB;
  
    color: white;
  }
  
  
  .cancel-btn::after,
  .confirm-btn::after {
    border: none;
  }